{
  "name": "artbook-project",
  "private": true,
  "type": "module",
  "workspaces": [
    "journey-ar",
    "journey-virtual-book-camera",
    "tools"
  ],
  "scripts": {
    "dev": "npm run dev -w journey-ar",
    "dev:vcam": "npm run dev -w journey-virtual-book-camera",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e --workspaces --if-present --",
    "check-env": "npm run check-env -w tools",
    "unity:fix": "npm run unity:fix -w tools",
    "unity:check": "npm run unity:check -w tools",
    "unity:render": "npm run unity:render -w tools",
    "unity:export": "npm run unity:export -w tools",
    "gltf:inspect": "npm run gltf:inspect -w tools",
    "assets:publish": "npm run assets:publish -w tools --",
    "ui:publish": "npm run ui:publish -w tools",
    "pages:normalize": "npm run pages:normalize -w tools --",
    "nft:generate": "npm run nft:generate -w tools --",
    "nft:probe": "npm run nft:probe -w tools --",
    "scenes:compare": "npm run compare -w journey-ar",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
