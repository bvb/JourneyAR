{
  "name": "journey-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "check-env": "node check-env.mjs",
    "unity:fix": "node unity/apply-fixes.mjs",
    "unity:check": "node unity/run-unity.mjs Journey.UnityExport.ProjectCheck.Run",
    "unity:render": "node unity/run-unity.mjs Journey.UnityExport.ReferenceRenderer.RenderAll",
